# Optional: enables the Claude-powered agent (tool calling, any Indian language).
# Without it the app uses the built-in offline agent, which calls the same tools.
ANTHROPIC_API_KEY=

# Secret used to sign form drafts so only reviewed, tool-generated drafts can be submitted.
DRAFT_SIGNING_SECRET=change-me-to-a-long-random-string

# Optional: server-side speech fallback (Sarvam AI — https://dashboard.sarvam.ai).
# Used when the browser has no voice for a language (e.g. Tamil/Telugu/Kannada on many
# devices) or no Web Speech recognition (Firefox, Safari, many Androids).
# Without it, voice uses only the browser's Web Speech API.
SARVAM_API_KEY=
# SPEECH_PROVIDER=sarvam
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=priya
# SARVAM_STT_MODEL=saaras:v3
