# ── AI engine ───────────────────────────────────────────────────────────────
# FREE option: Sarvam AI (https://dashboard.sarvam.ai) — one key powers the chat agent
# (sarvam-105b tool calling), document reading (Sarvam Vision) and voice (TTS/STT).
SARVAM_API_KEY=
# Optional paid alternative: Claude (better reasoning). Used first if set, unless LLM_PROVIDER says otherwise.
ANTHROPIC_API_KEY=
# claude | sarvam | offline. Unset → Claude if its key is set, else Sarvam, else the offline rule-based agent.
# If the chosen engine fails, the agent falls back to Sarvam, then offline.
LLM_PROVIDER=sarvam
# SARVAM_CHAT_MODEL=sarvam-105b-conversations   # fast (~1 s); use sarvam-105b for deeper reasoning

# Secret used to sign form drafts so only reviewed, tool-generated drafts can be submitted.
DRAFT_SIGNING_SECRET=change-me-to-a-long-random-string

# Voice: with SARVAM_API_KEY set (above), speech falls back to Sarvam when the browser has no voice
# for a language (e.g. Tamil/Telugu/Kannada on many devices) or no Web Speech recognition
# (Firefox, Safari, many Androids). Without it, voice uses only the browser's Web Speech API.
# SPEECH_PROVIDER=sarvam
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=priya
# SARVAM_STT_MODEL=saaras:v3

# ── Server persistence (optional) ───────────────────────────────────────────
# Unset → applications and reminders stay in the browser's localStorage only.
# Local dev:  DATABASE_URL=file:./data/jansahay.db   (SQLite via Node's built-in node:sqlite, Node ≥ 22.5)
# Production: DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require   (Neon)
DATABASE_URL=file:./data/jansahay.db

# Signs the httpOnly session cookie issued after WhatsApp OTP verification (falls back to DRAFT_SIGNING_SECRET).
SESSION_SECRET=change-me-to-another-long-random-string

# Protects /api/cron/reminders. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# If unset, the route is open in development and refused in production.
CRON_SECRET=

# ── Outbound WhatsApp (OTP + reminders) ─────────────────────────────────────
# console (default) = dry run: messages are logged, nothing is sent, demo OTP is 123456.
# whatsapp | twilio | msg91 = real delivery with the settings below.
NOTIFY_PROVIDER=console

# Meta WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Approved template names (body {{1}} = code / task, {{2}} = due date), one per language code.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_REMINDER_TEMPLATE=

# Twilio (WhatsApp channel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# MSG91 (WhatsApp)
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
MSG91_OTP_TEMPLATE=
MSG91_REMINDER_TEMPLATE=
